---
import { getCollection } from 'astro:content';
import Moved from '../../../layouts/Moved.astro';
import { targetFor } from '../../../data/redirects';

// Posts stay in src/content/guide/; only the page output became a redirect.
export async function getStaticPaths() {
  const posts = await getCollection('guide', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug } }));
}
---
<Moved to={targetFor(`/en/guide/${Astro.params.slug}/`)} lang="en" />
