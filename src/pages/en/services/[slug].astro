---
import Moved from '../../../layouts/Moved.astro';
import { servicesEn } from '../../../i18n/en';
import { targetFor } from '../../../data/redirects';

export function getStaticPaths() {
  return servicesEn.map((s) => ({ params: { slug: s.slug } }));
}
---
<Moved to={targetFor(`/en/services/${Astro.params.slug}/`)} lang="en" />
