---
import Moved from '../../layouts/Moved.astro';
import { services } from '../../data/site';
import { targetFor } from '../../data/redirects';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}
---
<Moved to={targetFor(`/hizmetler/${Astro.params.slug}/`)} lang="tr" />
