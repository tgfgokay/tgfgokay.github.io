---
import { getCollection } from 'astro:content';
import Moved from '../../layouts/Moved.astro';
import { targetFor } from '../../data/redirects';

// Yazılar src/content/rehber/ altında duruyor; yalnız sayfa çıktısı yönlendirmeye döndü.
export async function getStaticPaths() {
  const posts = await getCollection('rehber', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug } }));
}
---
<Moved to={targetFor(`/rehber/${Astro.params.slug}/`)} lang="tr" />
